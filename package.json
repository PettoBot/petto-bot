{
  "name": "petto",
  "version": "0.4.1",
  "description": "Petto - a multi-purpose Discord bot focused on moderation, with leveling, welcome messages, reaction roles and utility commands.",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "deploy-commands": "node deploy-commands.js",
    "check": "node scripts/check-syntax.js",
    "types:check": "tsc --project jsconfig.json --noEmit",
    "build:ts": "node scripts/build-types.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@polar-sh/sdk": "^0.49.0",
    "@supabase/supabase-js": "^2.45.4",
    "cloudflared": "^0.7.1",
    "discord.js": "^14.15.3",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "8.6.2",
    "ms": "^2.1.3",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
